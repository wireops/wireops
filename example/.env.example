# --------------------------------------------------------------------
#                              Server
# --------------------------------------------------------------------

# Keep server and worker on the exact same release. Review release notes and
# docs/UPGRADING.md before changing this value.
WIREOPS_VERSION=0.2.11

# Required — exactly 32 raw bytes or 64 hexadecimal characters.
# Generate with: openssl rand -hex 32
SECRET_KEY=

# Bootstrap token (required for first admin setup)
# On first run, visit the server URL at /setup to create the initial administrator account.
BOOTSTRAP_TOKEN=

# Public URL of the server (used for CORS and webhooks)
APP_URL=http://localhost:8090

# Host port to expose for the wireops web UI
PORT=8090

# Where PocketBase stores its data (databases, migrations)
PB_DATA_DIR=/data/pb_data

# On Linux, prepare the bind-mounted data directory before first start:
#   mkdir -p data
#   sudo chown -R 1000:1000 data

# --------------------------------------------------------------------
#                              Worker
# --------------------------------------------------------------------

# Worker connection URL. The in-file Docker network is plain HTTP while
# TLS_ENABLED=false. Use https:// for native TLS on remote hosts.
SERVER_URL=http://wireops:8443

# Registration / authorization token generated from the wireops admin panel
WORKER_TOKEN=

# Required comma-separated routing tags; letters, numbers, - and _ only.
WORKER_TAGS=dev

# Optional: override the name shown in the wireops UI
WORKER_HOSTNAME=worker-01

# Numeric group that owns /var/run/docker.sock on the Linux host:
#   stat -c '%g' /var/run/docker.sock
# Docker Desktop users can normally keep the default.
DOCKER_GID=0

# Host port to expose for the worker WebSocket channel (token-authenticated
# HTTP/WebSocket by default, not mutual TLS)
TLS_WORKER_PORT=8443

# Native TLS for worker registration/WebSocket traffic. The example persists
# generated certificates under /data/pb_data/tls. Enabling this requires the
# worker's SERVER_URL to use https:// on port 8443, and either a
# worker-trusted certificate (from TLS_CERT_FILE/TLS_KEY_FILE or a public CA)
# or an explicit self-signed exception via WORKER_TLS_SKIP_VERIFY.
TLS_ENABLED=false
# SERVER_DOMAIN=wireops.example.com
# TLS_CERT_FILE=/path/in/container/tls-cert.pem
# TLS_KEY_FILE=/path/in/container/tls-key.pem
TLS_DATA_DIR=/data/pb_data/tls

# Only for a controlled self-signed TLS setup where you explicitly accept the
# certificate. Never use this to bypass a validation failure for a publicly
# trusted certificate.
WORKER_TLS_SKIP_VERIFY=false

# Where git repositories are cloned
REPOS_WORKSPACE=/data/repos
